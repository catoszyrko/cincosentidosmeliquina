Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# sitemap.xml y robots.txt (Apache no usa router.php)
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Desarrollo local: no redirigir a producción
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^::1$ [NC,OR]
RewriteCond %{HTTP_HOST} \.(local|test|localhost)$ [NC]
RewriteRule ^ - [L]

# islapuravida.com.ar, www y cualquier otro host → canónico HTTPS sin www
RewriteCond %{HTTP_HOST} !^islapuravidatigre\.com\.ar$ [NC]
RewriteRule ^ https://islapuravidatigre.com.ar%{REQUEST_URI} [R=301,L]

# HTTP → HTTPS en el host canónico
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://islapuravidatigre.com.ar%{REQUEST_URI} [R=301,L]
</IfModule>
