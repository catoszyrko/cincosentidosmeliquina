# Cinco Sentidos Meliquina — Apache (Donweb / Ferozo)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio único (https y sin www). Desactivado: el sitio responde en
  # cualquier dominio. Para activarlo, descomentar estas líneas y poner
  # force_canonical_host => true en inc/config.php.
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  #
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # index.php / index.html (URL del sitio anterior) → carpeta (301).
  # Usa la ruta pedida, así funciona también si el sitio está en una subcarpeta.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^?\s]*/)?)index\.(php|html?)[\s?]
  RewriteRule (^|/)index\.(php|html?)$ %1 [R=301,L]

  # Archivos internos: no se sirven
  RewriteRule ^(inc|includes|views|data|migrations)(/|$) 404.php [END]
  RewriteRule ^(router|sitemap|robots)\.php$ 404.php [END]
  RewriteRule (^|/)\.(?!well-known/) 404.php [END]

  # robots.txt y sitemap.xml dinámicos
  RewriteRule ^robots\.txt$ robots.php [END]
  RewriteRule ^sitemap\.xml$ sitemap.php [END]

  # Página 404 propia para todo lo que no existe
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [END]
</IfModule>

<FilesMatch "\.(md|sql|log|json|lock|sh|py|ini|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|jpe?g|png|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
